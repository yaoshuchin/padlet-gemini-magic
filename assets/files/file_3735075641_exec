iv id\x3d\\\x22pdf-reader\\\x22 class\x3d\\\x22reader-overlay hidden\\\x22\x3e\\n            \x3cdiv class\x3d\\\x22reader-content\\\x22 id\x3d\\\x22reader-container\\\x22\x3e\\n                \\n            \x3c\\\/div\x3e\\n            \x3cdiv class\x3d\\\x22reader-toolbar\\\x22\x3e\\n                \x3cdiv class\x3d\\\x22left\\\x22\x3e\x3c\\\/div\x3e\\n                \x3cdiv class\x3d\\\x22center\\\x22\x3e\\n                    \x3cbutton id\x3d\\\x22btn-prev\\\x22 class\x3d\\\x22btn small\\\x22\x3e◀\x3c\\\/button\x3e\\n                    \x3cspan id\x3d\\\x22page-num\\\x22\x3e1\x3c\\\/span\x3e \/ \x3cspan id\x3d\\\x22page-count\\\x22\x3e--\x3c\\\/span\x3e\\n                    \x3cbutton id\x3d\\\x22btn-next\\\x22 class\x3d\\\x22btn small\\\x22\x3e▶\x3c\\\/button\x3e\\n                \x3c\\\/div\x3e\\n                \x3cdiv class\x3d\\\x22right\\\x22\x3e\\n                    \x3cbutton id\x3d\\\x22btn-toggle-theme\\\x22 class\x3d\\\x22btn small\\\x22 title\x3d\\\x22夜間模式\\\x22\x3e🌙\x3c\\\/button\x3e\\n                    \x3cbutton id\x3d\\\x22btn-zoom-out\\\x22 class\x3d\\\x22btn small\\\x22\x3e－\x3c\\\/button\x3e\\n                    \x3cspan id\x3d\\\x22zoom-level\\\x22\x3e100%\x3c\\\/span\x3e\\n                    \x3cbutton id\x3d\\\x22btn-zoom-in\\\x22 class\x3d\\\x22btn small\\\x22\x3e＋\x3c\\\/button\x3e\\n                    \x3cbutton id\x3d\\\x22btn-close-reader\\\x22 class\x3d\\\x22btn small\\\x22 style\x3d\\\x22background:#e74c3c\\\x22\x3e關閉\x3c\\\/button\x3e\\n                \x3c\\\/div\x3e\\n            \x3c\\\/div\x3e\\n        \x3c\\\/div\x3e\\n\\n        \x3cfooter class\x3d\\\x22footer\\\x22\x3e\\n            \x3cp\x3e\\n                \x3ca href\x3d\\\x22#\\\x22 id\x3d\\\x22btn-upload-modal\\\x22\x3e上傳書籍\x3c\\\/a\x3e |\\n                © 3cfish 電子書櫃 |\\n                \x3ca href\x3d\\\x22#\\\x22 id\x3d\\\x22link-admin-login\\\x22\x3e管理員登入\x3c\\\/a\x3e\\n            \x3c\\\/p\x3e\\n        \x3c\\\/footer\x3e\\n    \x3c\\\/div\x3e\\n\\n    \\n    \x3cscript src\x3d\\\x22https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/Sortable\/1.15.0\/Sortable.min.js\\\x22\x3e\x3c\\\/script\x3e\\n    \\n    \x3cscript src\x3d\\\x22https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/pdf.js\/3.11.174\/pdf.min.js\\\x22\x3e\x3c\\\/script\x3e\\n    \x3cscript\x3e\\n        pdfjsLib.GlobalWorkerOptions.workerSrc \x3d \x27https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/pdf.js\/3.11.174\/pdf.worker.min.js\x27;\\n    \x3c\\\/script\x3e\\n\\n    \x3cscript\x3e\\n    \\n    let allBooks \x3d \x5b\x5d;\\n    let activeCategory \x3d \x27all\x27;\\n    let isAdmin \x3d false;\\n    let isSorting \x3d false;\\n    let bookSortable \x3d null;\\n    let catSortable \x3d null;\\n    let allCategories \x3d \x5b\x5d;\\n\\n    \\n    let pdfDoc \x3d null;\\n    let pageNum \x3d 1;\\n    let scale \x3d 1.0;\\n    let isReaderOpen \x3d false;\\n\\n    \\n    function initApp() \x7b\\n        console.log(\x27App Initializing... (Window Loaded)\x27);\\n        const debugEl \x3d document.getElementById(\x27debug-status\x27);\\n        if (debugEl) \x7b\\n            debugEl.style.display \x3d \x27none\x27;\\n        \x7d\\n\\n        \\n        const btnOpenUpload \x3d document.getElementById(\x27btn-upload-modal\x27);\\n        const btnCloseUpload \x3d document.querySelector(\x27.close-btn\x27);\\n        const btnStartUpload \x3d document.getElementById(\x27btn-start-upload\x27);\\n        const btnLogout \x3d document.getElementById(\x27btn-logout\x27);\\n        const btnToggleSort \x3d document.getElementById(\x27btn-toggle-sort\x27);\\n        const btnAddCat \x3d document.getElementById(\x27btn-add-cat\x27);\\n        const linkAdminLogin \x3d document.getElementById(\x27link-admin-login\x27);\\n        const modal \x3d document.getElementById(\x27upload-modal\x27);\\n        const statusLog \x3d document.getElementById(\x27upload-status\x27);\\n        const uploadFileInput \x3d document.getElementById(\x27upload-files\x27);\\n\\n        \\n        const reader \x3d document.getElementById(\x27pdf-reader\x27);\\n        const btnCloseReader \x3d document.getElementById(\x27btn-close-reader\x27);\\n        const btnPrev \x3d document.getElementById(\x27btn-prev\x27);\\n        const btnNext \x3d document.getElementById(\x27btn-next\x27);\\n        const btnZoomIn \x3d document.getElementById(\x27btn-zoom-in\x27);\\n        const btnZoomOut \x3d document.getElementById(\x27btn-zoom-out\x27);\\n        const btnTheme \x3d document.getElementById(\x27btn-toggle-theme\x27);\\n\\n        if (!btnOpenUpload) \x7b\\n            console.warn(\x27UI Elements not found (Retrying)...\x27);\\n            if (debugEl) debugEl.textContent \x3d \x27JS: Waiting for UI...\x27;\\n            setTimeout(initApp, 500);\\n            return;\\n        \x7d\\n\\n        \\n        \\n\\n        btnOpenUpload.onclick \x3d (e) \x3d\x3e \x7b\\n            if (e) e.preventDefault();\\n            if (modal) \x7b\\n                modal.classList.remove(\x27hidden\x27);\\n                if (statusLog) statusLog.innerHTML \x3d \x27\x27;\\n                document.getElementById(\x27upload-file-list\x27).innerHTML \x3d \x27\x27; \\n                if (uploadFileInput) uploadFileInput.value \x3d \x27\x27; \\n            \x7d\\n        \x7d;\\n\\n        if (uploadFileInput) \x7b\\n            uploadFileInput.onchange \x3d handleFileSelect;\\n        \x7d\\n\\n        if (btnCloseUpload) \x7b\\n            btnCloseUpload.onclick \x3d () \x3d\x3e \x7b\\n                if (modal) modal.classList.add(\x27hidden\x27);\\n            \x7d;\\n        \x7d\\n\\n        if (btnStartUpload) \x7b\\n            btnStartUpload.onclick \x3d handleUpload;\\n        \x7d\\n\\n        if (linkAdminLogin) \x7b\\n            linkAdminLogin.onclick \x3d handleAdminLogin;\\n        \x7d\\n\\n        if (btnLogout) \x7b\\n            btnLogout.onclick \x3d () \x3d\x3e location.reload();\\n        \x7d\\n\\n        if (btnToggleSort) \x7b\\n            btnToggleSort.onclick \x3d toggleSorting;\\n        \x7d\\n\\n        if (btnAddCat) \x7b\\n            btnAddCat.onclick \x3d handleAddCategory;\\n        \x7d\\n\\n        \\n        if (btnCloseReader) btnCloseReader.onclick \x3d closeReader;\\n        if (btnPrev) btnPrev.onclick \x3d onPrevPage;\\n        if (btnNext) btnNext.onclick \x3d onNextPage;\\n        if (btnZoomIn) btnZoomIn.onclick \x3d () \x3d\x3e \x7b scale +\x3d 0.1; updateZoomUI(); renderPage(pageNum); \x7d;\\n        btnZoomOut.onclick \x3d () \x3d\x3e \x7b if (scale \x3e 0.2) scale -\x3d 0.1; updateZoomUI(); renderPage(pageNum); \x7d;\\n\\n        btnTheme.onclick \x3d () \x3d\x3e \x7b\\n            document.getElementById(\x27pdf-reader\x27).classList.toggle(\x27dark-mode\x27);\\n        \x7d;\\n\\n        \\n        window.addEventListener(\x27keydown\x27, (e) \x3d\x3e \x7b\\n            if (!isReaderOpen) return;\\n            switch (e.key) \x7b\\n                case \x27ArrowLeft\x27: onPrevPage(); break;\\n                case \x27ArrowRight\x27: onNextPage(); break;\\n                case \x27Escape\x27: closeReader(); break;\\n            \x7d\\n        \x7d);\\n\\n        \\n        loadData();\\n    \x7d\\n\\n    \\n    window.addEventListener(\x27load\x27, initApp);\\n\\n    \\n\\n    \\n\\n    function handleFileSelect(e) \x7b\\n        const files \x3d e.target.files;\\n        const listContainer \x3d document.getElementById(\x27upload-file-list\x27);\\n        listContainer.innerHTML \x3d \x27\x27;\\n\\n        Array.from(files).forEach((file, index) \x3d\x3e \x7b\\n            const item \x3d document.createElement(\x27div\x27);\\n            item.className \x3d \x27file-item\x27;\\n\\n            \\n            const nameParts \x3d file.name.split(\x27.\x27);\\n            let ext \x3d \x27\x27;\\n            let baseName \x3d file.name;\\n            if (nameParts.length \x3e 1) \x7b\\n                ext \x3d \x27.\x27 + nameParts.pop();\\n                baseName \x3d nameParts.join(\x27.\x27);\\n            \x7d\\n\\n            item.innerHTML \x3d `\\n                \x3cspan\x3e$\x7bfile.name\x7d\x3c\\\/span\x3e\\n                \x3cinput type\x3d\\\x22text\\\x22 data-idx\x3d\\\x22$\x7bindex\x7d\\\x22 value\x3d\\\x22$\x7bbaseName\x7d\\\x22 placeholder\x3d\\\x22輸入書籍名稱\\\x22\x3e \\n                \x3cspan\x3e$\x7bext\x7d\x3c\\\/span\x3e\\n            `;\\n            listContainer.appendChild(item);\\n        \x7d);\\n    \x7d\\n\\n    async function handleUpload() \x7b\\n        const btnStartUpload \x3d document.getElementById(\x27btn-start-upload\x27);\\n        const password \x3d document.getElementById(\x27upload-password\x27).value;\\n        const fileInput \x3d document.getElementById(\x27upload-files\x27);\\n        const files \x3d fileInput.files;\\n        const nameInputs \x3d document.querySelectorAll(\x27#upload-file-list input\x27);\\n        const categoryId \x3d document.getElementById(\x27upload-category\x27).value;\\n\\n        if (!password) \x7b\\n            log(\x27請輸入通關密碼\x27, \x27error\x27);\\n            return;\\n        \x7d\\n        if (files.length \x3d\x3d\x3d 0) \x7b\\n            log(\x27請選擇至少一個檔案\x27, \x27error\x27);\\n            return;\\n        \x7d\\n\\n        btnStartUpload.disabled \x3d true;\\n        btnStartUpload.textContent \x3d \x27上傳中...\x27;\\n\\n        log(`準備上傳 $\x7bfiles.length\x7d 個檔案...`);\\n\\n        for (let i \x3d 0; i \x3c files.length; i++) \x7b\\n            const file \x3d files\x5bi\x5d;\\n\\n            \\n            let customName \x3d file.name;\\n            if (nameInputs\x5bi\x5d) \x7b\\n                const nameParts \x3d file.name.split(\x27.\x27);\\n                const ext \x3d nameParts.length \x3e 1 ? nameParts.pop() : \x27\x27;\\n                const val \x3d nameInputs\x5bi\x5d.value.trim();\\n                if (val) customName \x3d val + (ext ? \x27.\x27 + ext : \x27\x27);\\n            \x7d\\n\\n            log(`\x5b$\x7bi + 1\x7d\/$\x7bfiles.length\x7d\x5d 正在上傳: $\x7bcustomName\x7d...`); \/\/ Log custom name\\n\\n            try \x7b\\n                const base64 \x3d await toBase64(file);\\n                const data \x3d base64.split(\x27,\x27)\x5b1\x5d;\\n\\n                await runGoogleScript(\x27uploadBook\x27, \x5bdata, customName, file.type, password, categoryId\x5d) \\n                    .then(res \x3d\x3e \x7b\\n                        if (res.success) \x7b\\n                            log(`✅ $\x7bcustomName\x7d: 上傳成功`, \x27success\x27);\\n                        \x7d else \x7b\\n                            log(`❌ $\x7bcustomName\x7d: 失敗 - $\x7bres.message\x7d`, \x27error\x27);\\n                        \x7d\\n                    \x7d)\\n                    .catch(err \x3d\x3e log(`❌ $\x7bcustomName\x7d: 系統錯誤 - $\x7berr\x7d`, \x27error\x27));\\n\\n            \x7d catch (e) \x7b\\n                log(`❌ $\x7bcustomName\x7d: 檔案讀取失敗`, \x27error\x27);\\n            \x7d\\n        \x7d\\n\\n        log(\x27所有作業結束\x27);\\n        btnStartUpload.disabled \x3d false;\\n        btnStartUpload.textContent \x3d \x27開始上傳\x27;\\n        loadData();\\n    \x7d\\n\\n    async function handleAdminLogin(e) \x7b\\n        if (e) e.preventDefault();\\n        const pwd \x3d prompt(\x27請輸入管理密碼:\x27);\\n        if (pwd) \x7b\\n            const result \x3d await runGoogleScript(\x27loginAdmin\x27, \x5bpwd\x5d);\\n            if (result) \x7b\\n                isAdmin \x3d true;\\n                document.getElementById(\x27admin-bar\x27).classList.remove(\x27hidden\x27);\\n                alert(\x27登入成功\x27);\\n                \\n                const cats \x3d await runGoogleScript(\x27getCategories\x27, \x5b\x5d);\\n                renderCategories(cats);\\n            \x7d else \x7b\\n                alert(\x27密碼錯誤\x27);\\n            \x7d\\n        \x7d\\n    \x7d\\n\\n    function toggleSorting() \x7b\\n        const btn \x3d document.getElementById(\x27btn-toggle-sort\x27);\\n        isSorting \x3d !isSorting;\\n        btn.textContent \x3d isSorting ? \x27儲存排序\x27 : \x27開啟排序\x27;\\n        btn.classList.toggle(\x27primary\x27, isSorting);\\n\\n        if (isSorting) enableSorting();\\n        else disableSorting();\\n    \x7d\\n\\n    async function handleAddCategory() \x7b\\n        const name \x3d prompt(\x27請輸入分類名稱:\x27);\\n        if (name) \x7b\\n            await runGoogleScript(\x27addCategory\x27, \x5bname\x5d);\\n            loadData();\\n        \x7d\\n    \x7d\\n\\n    \\n\\n    async function loadData() \x7b\\n        try \x7b\\n            const \x5bbooks, categories, config\x5d \x3d await Promise.all(\x5b\\n                runGoogleScript(\x27getBooks\x27, \x5b\x5d),\\n                runGoogleScript(\x27getCategories\x27, \x5b\x5d),\\n                runGoogleScript(\x27getConfig\x27, \x5b\x5d)\\n            \x5d);\\n\\n            \\n            if (config \x26\x26 config\x5b\x27網站名稱\x27\x5d) \x7b\\n                document.title \x3d config\x5b\x27網站名稱\x27\x5d;\\n                document.querySelector(\x27header h1\x27).textContent \x3d config\x5b\x27網站名稱\x27\x5d;\\n            \x7d\\n\\n            allBooks \x3d books;\\n            allCategories \x3d categories;\\n            renderCategories(categories);\\n            renderBooks(allBooks);\\n\\n        \x7d catch (e) \x7b\\n            console.error(e);\\n            document.getElementById(\x27book-grid\x27).innerHTML \x3d \x27\x3cdiv class\x3d\\\x22empty-state\\\x22\x3e載入失敗: \x27 + e + \x27\x3c\\\/div\x3e\x27;\\n        \x7d\\n    \x7d\\n\\n    function renderCategories(categories) \x7b\\n        const container \x3d document.getElementById(\x27category-filter\x27);\\n        const allBtn \x3d container.querySelector(\x27\x5bdata-id\x3d\\\x22all\\\x22\x5d\x27);\\n        container.innerHTML \x3d \x27\x27;\\n        container.appendChild(allBtn);\\n\\n        \\n        const uploadSelect \x3d document.getElementById(\x27upload-category\x27);\\n        if (uploadSelect) \x7b\\n            uploadSelect.innerHTML \x3d \x27\x3coption value\x3d\\\x22\\\x22\x3e(無分類)\x3c\\\/option\x3e\x27;\\n            categories.forEach(cat \x3d\x3e \x7b\\n                const opt \x3d document.createElement(\x27option\x27);\\n                opt.value \x3d cat.id;\\n                opt.textContent \x3d cat.name;\\n                uploadSelect.appendChild(opt);\\n            \x7d);\\n        \x7d\\n\\n        categories.forEach(cat \x3d\x3e \x7b\\n            const btn \x3d document.createElement(\x27button\x27);\\n            btn.className \x3d \x27cat-btn\x27;\\n            btn.textContent \x3d cat.name;\\n            btn.dataset.id \x3d cat.id;\\n\\n            btn.onclick \x3d () \x3d\x3e \x7b\\n                if (!isSorting) filterBooks(cat.id);\\n            \x7d;\\n\\n            btn.oncontextmenu \x3d (e) \x3d\x3e \x7b\\n                if (isAdmin \x26\x26 !isSorting) \x7b\\n                    e.preventDefault();\\n                    if (confirm(`管理分類: $\x7bcat.name\x7d\\\\n\\\\n\x5b確定\x5d 修改名稱\\\\n\x5b取消\x5d 刪除分類`)) \x7b\\n                        const newName \x3d prompt(\x27修改名稱:\x27, cat.name);\\n                        if (newName) runGoogleScript(\x27renameCategory\x27, \x5bcat.id, newName\x5d).then(loadData);\\n                    \x7d else \x7b\\n                        if (confirm(`確定要刪除分類「$\x7bcat.name\x7d」嗎？`)) \x7b\\n                            runGoogleScript(\x27deleteCategory\x27, \x5bcat.id\x5d).then(loadData);\\n                        \x7d\\n                    \x7d\\n                \x7d\\n            \x7d;\\n            container.appendChild(btn);\\n        \x7d);\\n\\n        allBtn.onclick \x3d () \x3d\x3e filterBooks(\x27all\x27);\\n    \x7d\\n\\n    function filterBooks(catId) \x7b\\n        activeCategory \x3d catId;\\n        document.querySelectorAll(\x27.cat-btn\x27).forEach(btn \x3d\x3e \x7b\\n            if (btn.dataset.id \x3d\x3d\x3d catId) btn.classList.add(\x27active\x27);\\n            else btn.classList.remove(\x27active\x27);\\n        \x7d);\\n\\n        if (catId \x3d\x3d\x3d \x27all\x27) renderBooks(allBooks);\\n        else renderBooks(allBooks.filter(b \x3d\x3e String(b.categoryId) \x3d\x3d\x3d String(catId)));\\n    \x7d\\n\\n    function renderBooks(books) \x7b\\n        const grid \x3d document.getElementById(\x27book-grid\x27);\\n        grid.innerHTML \x3d \x27\x27;\\n\\n        if (books.length \x3d\x3d\x3d 0) \x7b\\n            const emptyState \x3d document.createElement(\x27div\x27);\\n            emptyState.className \x3d \x27empty-state\x27;\\n            emptyState.textContent \x3d \x27此分類下沒有書籍\x27;\\n            grid.appendChild(emptyState);\\n            return;\\n        \x7d\\n\\n        books.forEach(book \x3d\x3e \x7b\\n            const card \x3d document.createElement(\x27div\x27);\\n            card.className \x3d \x27book-card\x27;\\n            card.dataset.id \x3d book.id;\\n\\n            card.onclick \x3d () \x3d\x3e \x7b\\n                if (!isSorting) openReader(book.fileId, book.name, book.id);\\n            \x7d;\\n\\n            \\n            const img \x3d document.createElement(\x27img\x27);\\n            img.className \x3d \x27book-thumb\x27;\\n            img.loading \x3d \x27lazy\x27;\\n            img.src \x3d \x27https:\/\/drive.google.com\/thumbnail?id\x3d\x27 + book.fileId + \x27\x26sz\x3dw400\x27;\\n            img.onerror \x3d function () \x7b this.src \x3d \x27https:\/\/via.placeholder.com\/200x280?text\x3dNo+Cover\x27; \x7d;\\n            card.appendChild(img);\\n\\n            \\n            const info \x3d document.createElement(\x27div\x27);\\n            info.className \x3d \x27book-info\x27;\\n\\n            \\n            const catName \x3d allCategories.find(c \x3d\x3e String(c.id) \x3d\x3d\x3d String(book.categoryId))?.name || \x27未分類\x27;\\n            const catTag \x3d document.createElement(\x27span\x27);\\n            catTag.className \x3d \x27book-tag\x27;\\n            catTag.textContent \x3d catName;\\n\\n            \\n            const title \x3d document.createElement(\x27div\x27);\\n            title.className \x3d \x27book-title\x27;\\n            title.title \x3d book.name;\\n            title.textContent \x3d book.name;\\n\\n            \\n            if (isAdmin) \x7b\\n                const btnDelete \x3d document.createElement(\x27button\x27);\\n                btnDelete.className \x3d \x27btn-delete-book\x27;\\n                btnDelete.innerHTML \x3d \x27🗑️\x27;\\n                btnDelete.title \x3d \x27刪除書籍\x27;\\n                btnDelete.onclick \x3d (e) \x3d\x3e \x7b\\n                    e.stopPropagation(); \\n                    if (confirm(`確定要刪除「$\x7bbook.name\x7d」嗎？\\\\n(注意：這將永久刪除 PDF 檔案)`)) \x7b\\n                        runGoogleScript(\x27deleteBook\x27, \x5bbook.id\x5d).then(() \x3d\x3e \x7b\\n                            loadData();\\n                        \x7d);\\n                    \x7d\\n                \x7d;\\n                card.appendChild(btnDelete);\\n            \x7d\\n\\n            info.appendChild(catTag); \\n            info.appendChild(title);\\n\\n            \\n            const meta \x3d document.createElement(\x27div\x27);\\n            meta.className \x3d \x27book-meta\x27;\\n\\n            const metaView \x3d document.createElement(\x27div\x27);\\n            metaView.className \x3d \x27meta-item\x27;\\n            metaView.textContent \x3d \x27👁️ \x27 + (book.views || 0);\\n\\n            const metaLike \x3d document.createElement(\x27div\x27);\\n            metaLike.className \x3d \x27meta-item meta-heart\x27;\\n            metaLike.textContent \x3d \x27❤️ \x27 + (book.likes || 0);\\n            metaLike.onclick \x3d (e) \x3d\x3e \x7b\\n                e.stopPropagation();\\n                runGoogleScript(\x27addLike\x27, \x5bbook.id\x5d).then(res \x3d\x3e \x7b\\n                    if (res.success) \x7b\\n                        book.likes \x3d res.newValue;\\n                        metaLike.textContent \x3d \x27❤️ \x27 + res.newValue;\\n                        metaLike.classList.add(\x27liked\x27); \\n                    \x7d\\n                \x7d);\\n            \x7d;\\n\\n            meta.appendChild(metaView);\\n            meta.appendChild(metaLike);\\n            info.appendChild(meta);\\n\\n            card.appendChild(info);\\n            grid.appendChild(card);\\n        \x7d);\\n    \x7d\\n\\n    \\n\\n    function enableSorting() \x7b\\n        const grid \x3d document.getElementById(\x27book-grid\x27);\\n        bookSortable \x3d new Sortable(grid, \x7b\\n            animation: 150,\\n            ghostClass: \x27sortable-chosen\x27\\n        \x7d);\\n\\n        const catList \x3d document.getElementById(\x27category-filter\x27);\\n        catSortable \x3d new Sortable(catList, \x7b\\n            animation: 150,\\n            filter: \x27.active\x27,\\n            onMove: function (evt) \x7b return evt.related.dataset.id !\x3d\x3d \x27all\x27; \x7d\\n        \x7d);\\n    \x7d\\n\\n    async function disableSorting() \x7b\\n        if (bookSortable) \x7b\\n            const newOrder \x3d bookSortable.toArray();\\n            await runGoogleScript(\x27saveBookOrder\x27, \x5bnewOrder\x5d);\\n            bookSortable.destroy();\\n            bookSortable \x3d null;\\n        \x7d\\n        if (catSortable) \x7b\\n            const newOrder \x3d catSortable.toArray().filter(id \x3d\x3e id !\x3d\x3d \x27all\x27);\\n            await runGoogleScript(\x27saveCategoryOrder\x27, \x5bnewOrder\x5d);\\n            catSortable.destroy();\\n            catSortable \x3d null;\\n        \x7d\\n        loadData();\\n    \x7d\\n\\n    \\n\\n    function log(msg, type \x3d \x27normal\x27) \x7b\\n        const statusLog \x3d document.getElementById(\x27upload-status\x27);\\n        if (!statusLog) return;\\n        const div \x3d document.createElement(\x27div\x27);\\n        div.className \x3d `log-item log-$\x7btype\x7d`;\\n        div.textContent \x3d msg;\\n        statusLog.appendChild(div);\\n        statusLog.scrollTop \x3d statusLog.scrollHeight;\\n    \x7d\\n\\n    function toBase64(file) \x7b\\n        return new Promise((resolve, reject) \x3d\x3e \x7b\\n            const reader \x3d new FileReader();\\n            reader.readAsDataURL(file);\\n            reader.onload \x3d () \x3d\x3e resolve(reader.result);\\n            reader.onerror \x3d error \x3d\x3e reject(error);\\n        \x7d);\\n    \x7d\\n\\n    function showLoading() \x7b document.body.style.cursor \x3d \x27wait\x27; \x7d\\n    function hideLoading() \x7b document.body.style.cursor \x3d \x27default\x27; \x7d\\n\\n    function runGoogleScript(funcName, args) \x7b\\n        showLoading();\\n        return new Promise((resolve, reject) \x3d\x3e \x7b\\n            if (!google || !google.script || !google.script.run) \x7b\\n                console.error(\x27GAS Environment not found.\x27);\\n                hideLoading();\\n                return reject(\x27Local Environment\x27);\\n            \x7d\\n            google.script.run\\n                .withSuccessHandler(res \x3d\x3e \x7b\\n                    hideLoading();\\n                    resolve(res);\\n                \x7d)\\n                .withFailureHandler(err \x3d\x3e \x7b\\n                    hideLoading();\\n                    alert(\x27系統錯誤: \x27 + err);\\n                    reject(err);\\n                \x7d)\\n            \x5bfuncName\x5d(...args);\\n        \x7d);\\n    \x7d\\n\\n    \\n    async function openReader(fileId, title, bookId) \x7b\\n        isReaderOpen \x3d true;\\n        document.getElementById(\x27pdf-reader\x27).classList.remove(\x27hidden\x27);\\n        document.body.style.overflow \x3d \x27hidden\x27; \\n\\n        \\n        pdfDoc \x3d null;\\n        pageNum \x3d 1;\\n        scale \x3d 1.0;\\n        document.getElementById(\x27zoom-level\x27).textContent \x3d \x27100%\x27;\\n        document.getElementById(\x27reader-container\x27).innerHTML \x3d \x27\x3cdiv style\x3d\\\x22color:white\\\x22\x3e載入中...\x3c\\\/div\x3e\x27;\\n\\n        try \x7b\\n            \\n            const result \x3d await runGoogleScript(\x27getBookContent\x27, \x5bfileId\x5d);\\n            const pdfData \x3d atob(result.base64);\\n\\n            const loadingTask \x3d pdfjsLib.getDocument(\x7b data: pdfData \x7d);\\n            pdfDoc \x3d await loadingTask.promise;\\n\\n            document.getElementById(\x27page-count\x27).textContent \x3d pdfDoc.numPages;\\n            document.getElementById(\x27reader-container\x27).innerHTML \x3d \x27\x27; \\n\\n            \\n            const page \x3d await pdfDoc.getPage(1);\\n            const viewport \x3d page.getViewport(\x7b scale: 1.0 \x7d);\\n            \\n            const containerH \x3d window.innerHeight - 50; \\n            const containerW \x3d window.innerWidth;\\n\\n            const scaleH \x3d containerH \/ viewport.height;\\n            const scaleW \x3d containerW \/ viewport.width;\\n\\n            \\n            scale \x3d Math.min(scaleH, scaleW) * 0.95;\\n            updateZoomUI();\\n\\n            renderPage(pageNum);\\n\\n            \\n            if (bookId) \x7b\\n                runGoogleScript(\x27addView\x27, \x5bbookId\x5d);\\n            \x7d\\n\\n            \\n            \\n            initTouchGestures();\\n\\n        \x7d catch (e) \x7b\\n            alert(\x27無法開啟書籍: \x27 + e);\\n            closeReader();\\n        \x7d\\n    \x7d\\n\\n    function closeReader() \x7b\\n        isReaderOpen \x3d false;\\n        document.getElementById(\x27pdf-reader\x27).classList.add(\x27hidden\x27);\\n        document.body.style.overflow \x3d \x27\x27;\\n        pdfDoc \x3d null;\\n    \x7d\\n\\n    \\n    \\n    \\n    \\n    \\n\\n    async function renderPage(num) \x7b\\n        if (!isReaderOpen || !pdfDoc) return;\\n\\n        const container \x3d document.getElementById(\x27reader-container\x27);\\n        container.innerHTML \x3d \x27\x27; \\n\\n        const isTwoPage \x3d (scale \x3c\x3d 1.0 \x26\x26 window.innerWidth \x3e 800 \x26\x26 num \x3c pdfDoc.numPages);\\n\\n        \\n        await renderSinglePage(num, container);\\n\\n        \\n        if (isTwoPage) \x7b\\n            await renderSinglePage(num + 1, container);\\n        \x7d\\n\\n        pageNum \x3d num;\\n        document.getElementById(\x27page-num\x27).textContent \x3d isTwoPage ? `$\x7bnum\x7d-$\x7bnum + 1\x7d` : num;\\n\\n        \\n        document.getElementById(\x27btn-prev\x27).disabled \x3d num \x3c\x3d 1;\\n        document.getElementById(\x27btn-next\x27).disabled \x3d num \x3e\x3d pdfDoc.numPages;\\n    \x7d\\n\\n    async function renderSinglePage(num, container) \x7b\\n        if (num \x3e pdfDoc.numPages) return;\\n\\n        const page \x3d await pdfDoc.getPage(num);\\n        const viewport \x3d page.getViewport(\x7b scale: scale \x7d);\\n\\n        const canvas \x3d document.createElement(\x27canvas\x27);\\n        const context \x3d canvas.getContext(\x272d\x27);\\n        canvas.className \x3d \x27pdf-canvas\x27;\\n        canvas.height \x3d viewport.height;\\n        canvas.width \x3d viewport.width;\\n\\n        container.appendChild(canvas);\\n\\n        const renderContext \x3d \x7b\\n            canvasContext: context,\\n            viewport: viewport\\n        \x7d;\\n        await page.render(renderContext).promise;\\n    \x7d\\n\\n    function onPrevPage() \x7b\\n        if (pageNum \x3c\x3d 1) return;\\n        const offset \x3d (scale \x3c\x3d 1.0 \x26\x26 window.innerWidth \x3e 800) ? 2 : 1;\\n        renderPage(Math.max(1, pageNum - offset));\\n    \x7d\\n\\n    function onNextPage() \x7b\\n        if (pageNum \x3e\x3d pdfDoc.numPages) return;\\n        const offset \x3d (scale \x3c\x3d 1.0 \x26\x26 window.innerWidth \x3e 800) ? 2 : 1;\\n        renderPage(Math.min(pdfDoc.numPages, pageNum + offset));\\n    \x7d\\n\\n    function updateZoomUI() \x7b\\n        document.getElementById(\x27zoom-level\x27).textContent \x3d Math.round(scale * 100) + \x27%\x27;\\n    \x7d\\n\\n    \\n    function initTouchGestures() \x7b\\n        const container \x3d document.getElementById(\x27reader-container\x27);\\n\\n        let touchstartX \x3d 0;\\n        let touchendX \x3d 0;\\n\\n        \\n        let initialDistance \x3d 0;\\n        let initialScale \x3d 1;\\n        let isPinching \x3d false;\\n\\n        \\n        let lastTapTime \x3d 0;\\n        let tapTimeout \x3d null;\\n\\n        container.ontouchstart \x3d (e) \x3d\x3e \x7b\\n            if (e.touches.length \x3d\x3d\x3d 1) \x7b\\n                \\n                touchstartX \x3d e.changedTouches\x5b0\x5d.screenX;\\n                \\n            \x7d else if (e.touches.length \x3d\x3d\x3d 2) \x7b\\n                \\n                isPinching \x3d true;\\n                initialDistance \x3d getDistance(e.touches);\\n                initialScale \x3d scale;\\n                \\n            \x7d\\n        \x7d;\\n\\n        \\n        let lastRatio \x3d 1;\\n\\n        container.ontouchmove \x3d (e) \x3d\x3e \x7b\\n            if (isPinching \x26\x26 e.touches.length \x3d\x3d\x3d 2) \x7b\\n                e.preventDefault();\\n                const currentDistance \x3d getDistance(e.touches);\\n                if (initialDistance \x3e 0) \x7b\\n                    lastRatio \x3d currentDistance \/ initialDistance;\\n\\n                    const canvas \x3d container.querySelector(\x27canvas\x27);\\n                    if (canvas) \x7b\\n                        canvas.style.transform \x3d `scale($\x7blastRatio\x7d)`;\\n                        canvas.style.transformOrigin \x3d \x27center\x27;\\n                    \x7d\\n                \x7d\\n            \x7d\\n        \x7d;\\n\\n        container.ontouchend \x3d (e) \x3d\x3e \x7b\\n            if (isPinching \x26\x26 e.touches.length \x3c 2) \x7b\\n                isPinching \x3d false;\\n\\n                \\n                if (lastRatio !\x3d\x3d 1) \x7b\\n                    let newScale \x3d initialScale * lastRatio;\\n                    \\n                    newScale \x3d Math.max(0.2, Math.min(newScale, 5.0));\\n\\n                    scale \x3d newScale; \\n                    updateZoomUI();\\n\\n                    \\n                    const canvas \x3d container.querySelector(\x27canvas\x27);\\n                    if (canvas) canvas.style.transform \x3d \x27none\x27;\\n\\n                    renderPage(pageNum);\\n                    lastRatio \x3d 1; \\n                \x7d\\n            \x7d else if (!isPinching) \x7b\\n                touchendX \x3d e.changedTouches\x5b0\x5d.screenX;\\n\\n                \\n                const moveDist \x3d Math.abs(touchendX - touchstartX);\\n\\n                if (moveDist \x3e 50) \x7b\\n                    \\n                    handleSwipe();\\n                \x7d else \x7b\\n                    \\n                    handleTap(e.changedTouches\x5b0\x5d);\\n                \x7d\\n            \x7d\\n        \x7d;\\n\\n        function handleTap(touch) \x7b\\n            const currentTime \x3d new Date().getTime();\\n            const tapLength \x3d currentTime - lastTapTime;\\n\\n            if (tapLength \x3c 300 \x26\x26 tapLength \x3e 0) \x7b\\n                \\n                if (tapTimeout) clearTimeout(tapTimeout);\\n                handleDoubleTap();\\n                lastTapTime \x3d 0;\\n            \x7d else \x7b\\n                \\n                lastTapTime \x3d currentTime;\\n                tapTimeout \x3d setTimeout(() \x3d\x3e \x7b\\n                    handleSingleTap(touch);\\n                \x7d, 300);\\n            \x7d\\n        \x7d\\n\\n        function handleDoubleTap() \x7b\\n            if (scale \x3e 1.2) \x7b\\n                scale \x3d 1.0; \\n            \x7d else \x7b\\n                scale \x3d 2.0; \\n            \x7d\\n            updateZoomUI();\\n            renderPage(pageNum);\\n        \x7d\\n\\n        function handleSingleTap(touch) \x7b\\n            const width \x3d window.innerWidth;\\n            const x \x3d touch.clientX;\\n\\n            \\n            if (x \x3c width * 0.3) \x7b\\n                onPrevPage();\\n            \x7d\\n            \\n            else if (x \x3e width * 0.7) \x7b\\n                onNextPage();\\n            \x7d\\n            \\n        \x7d\\n\\n        function handleSwipe() \x7b\\n            const threshold \x3d 50;\\n            if (touchendX \x3c touchstartX - threshold) \x7b\\n                onNextPage(); \\n            \x7d\\n            if (touchendX \x3e touchstartX + threshold) \x7b\\n                onPrevPage(); \\n            \x7d\\n        \x7d\\n\\n        function getDistance(touches) \x7b\\n            const dx \x3d touches\x5b0\x5d.clientX - touches\x5b1\x5d.clientX;\\n            const dy \x3d touches\x5b0\x5d.clientY - touches\x5b1\x5d.clientY;\\n            return Math.sqrt(dx * dx + dy * dy);\\n        \x7d\\n    \x7d\\n\x3c\\\/script\x3e\\n```\x3c\\\/body\x3e\\n\\n\x3c\\\/html\x3e\x22,\x22ncc\x22:\x22\x7b\\\x22awhs\\\x22:true\x7d\x22\x7d", "", undefined, true , false  , "false", "https:\/\/n-b6tnhjezorbkfxqex4tokxyflsabvf6zwtmdp2i-0lu-script.googleusercontent.com", "https:\/\/drive.google.com\/abuse?id\x3dAFS7AdtKr94mu2bxjGmpnLLbG9O5mwq9uZ5icNlc7NoKYgd_AcnXnqMqau7vWiLbSLSM1pK0tuRjlW-5oD-cG_jlB-FrlgYeYyBEp_Ob%3A0\x26docurl\x3dhttps%3A%2F%2Fscript.google.com%2Fa%2Fmacros%2Fgo.edu.tw%2Fs%2FAKfycbw_zN6h7MuRiODM3pfgIGwUJSCvAmlKYqNiZQcJLrmZcVYTlu38uyqh_DMQaBX5dKJh%2Fexec");}
