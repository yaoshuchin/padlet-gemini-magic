                                                                    <div class="prompt-card">
                                        <a class="d-block" href="https://uniform.wingzero.tw/zh-TW/prompts/art-style/324">
                                            <figure class="ratio ratio-4x3">
                                                <img src="https://farm66.static.flickr.com/65535/55110594102_9bd832e91d_b.jpg"
                                                     width="1024"
