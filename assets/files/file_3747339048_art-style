    <script type="17a725e204780b881d4bb2df-text/javascript">
        const {createApp, ref, reactive, computed, watch, onMounted, onBeforeUnmount} = Vue;
        const body = document.querySelector('body');
        const langBtn = document.querySelector('#langBtn');
        const langSwitcher = document.querySelector('#langSwitcher');
        const menuBtn = document.querySelector('#mobileMenuBtn');
        const mobileMenu = document.querySelector('#mobileMenu');
        const mobileMenuCloseBtn = document.querySelector('#mobileMenuCloseBtn');
        const mobileSubmenuItems = document.querySelectorAll('.mobile-menu li.has-submenu');

        const syncMobileSubmenuState = function (item) {
            const isOpen = item.classList.contains('open');
            const toggle = item.querySelector('.submenu-toggle');
            const submenu = item.querySelector('.mobile-submenu-list');

            toggle?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            submenu?.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
        };

        const resetMobileSubmenus = function () {
            mobileSubmenuItems.forEach(item => {
                const shouldOpen = item.dataset.defaultOpen === 'true';
                item.classList.toggle('open', shouldOpen);
                syncMobileSubmenuState(item);
            });
        };

        const closeMobileMenu = function () {
            if (!menuBtn || !mobileMenu) {
                return;
            }

            menuBtn.classList.remove('open');
            menuBtn.setAttribute('aria-expanded', 'false');
            mobileMenu.classList.remove('active');
            mobileMenu.setAttribute('aria-hidden', 'true');
            body.classList.remove('active');
            resetMobileSubmenus();
        };

        const openMobileMenu = function () {
            if (!menuBtn || !mobileMenu) {
                return;
            }

            menuBtn.classList.add('open');
            menuBtn.setAttribute('aria-expanded', 'true');
            mobileMenu.classList.add('active');
            mobileMenu.setAttribute('aria-hidden', 'false');
            body.classList.add('active');
        };

        langBtn?.addEventListener('click', function (e) {
            e.stopPropagation();
            langSwitcher?.classList.toggle('active');
        });
        body.addEventListener('click', function () {
            langSwitcher?.classList.remove('active');
            closeMobileMenu();
        });
        menuBtn?.addEventListener('click', function (e) {
            e.stopPropagation();
            langSwitcher?.classList.remove('active');
            if (mobileMenu?.classList.contains('active')) {
                closeMobileMenu();
            } else {
                openMobileMenu();
            }
        });
        mobileMenu?.addEventListener('click', function (e) {
            e.stopPropagation();
        });
        mobileMenuCloseBtn?.addEventListener('click', function (e) {
            e.stopPropagation();
            closeMobileMenu();
        });

        document.querySelectorAll('.submenu-toggle').forEach(toggle => {
            toggle.addEventListener('click', function (e) {
                e.stopPropagation();
                e.preventDefault();
                const parent = this.parentElement;
                parent.classList.toggle('open');
                syncMobileSubmenuState(parent);
            });
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                langSwitcher?.classList.remove('active');
                closeMobileMenu();
            }
        });
        resetMobileSubmenus();

        createApp({
            setup() {
                const dropdown = ref(false);
                const loginRootRef = ref(null);
                const isAuthenticated = false;
                const keepAliveUrl = "https:\/\/uniform.wingzero.tw\/zh-TW\/keep-alive";
                const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
                const keepAliveIntervalMs = 5 * 60 * 1000;
                const activeWindowMs = 10 * 60 * 1000;
                const activityEvents = ['click', 'keydown', 'mousemove', 'scroll', 'touchstart'];
                let lastActivityAt = Date.now();
                let lastKeepAliveAt = 0;
                let keepAliveTimer = null;

                const handleDocumentClick = (event) => {
                    if (!loginRootRef.value?.contains(event.target)) {
                        dropdown.value = false;
                    }
                };

                const refreshLoginSession = () => {
                    if (!isAuthenticated || document.visibilityState === 'hidden') {
                        return;
                    }

                    const now = Date.now();
                    if (now - lastKeepAliveAt < keepAliveIntervalMs) {
                        return;
                    }

                    lastKeepAliveAt = now;
                    axios.post(keepAliveUrl, {}, {
                        withCredentials: true,
                        headers: {
                            Accept: 'application/json',
                            ...(csrfToken ? {'X-CSRF-TOKEN': csrfToken} : {}),
                        },
                    })
                        .then(({data}) => {
                            if (data?.authenticated === false) {
                                stopSessionKeepAlive();
                                window.location.reload();
                            }
                        })
                        .catch((error) => {
                            if (error.response?.status === 401) {
                                stopSessionKeepAlive();
                                window.location.reload();
                            }
                        });
                };

                const handleUserActivity = () => {
                    lastActivityAt = Date.now();
                    refreshLoginSession();
                };

                const handlePageVisibilityChange = () => {
                    if (document.visibilityState === 'visible') {
                        lastActivityAt = Date.now();
                        refreshLoginSession();
                    }
                };

                const startSessionKeepAlive = () => {
                    if (!isAuthenticated) {
                        return;
                    }

                    activityEvents.forEach((eventName) => {
                        document.addEventListener(eventName, handleUserActivity, {passive: true});
                    });
                    document.addEventListener('visibilitychange', handlePageVisibilityChange);
                    window.addEventListener('focus', handlePageVisibilityChange);

                    refreshLoginSession();
                    keepAliveTimer = window.setInterval(() => {
                        if (Date.now() - lastActivityAt <= activeWindowMs) {
                            refreshLoginSession();
                        }
                    }, keepAliveIntervalMs);
                };

                const stopSessionKeepAlive = () => {
                    activityEvents.forEach((eventName) => {
                        document.removeEventListener(eventName, handleUserActivity);
                    });
                    document.removeEventListener('visibilitychange', handlePageVisibilityChange);
                    window.removeEventListener('focus', handlePageVisibilityChange);

                    if (keepAliveTimer) {
                        window.clearInterval(keepAliveTimer);
                    }
                };

                onMounted(() => {
                    loginRootRef.value = document.getElementById('login');
                    document.addEventListener('click', handleDocumentClick);
                    startSessionKeepAlive();
                });

                onBeforeUnmount(() => {
                    document.removeEventListener('click', handleDocumentClick);
                    stopSessionKeepAlive();
                });

                return {dropdown};
            }
        }).mount('#login');

        document.addEventListener('DOMContentLoaded', () => {
            if (window?.AOS) {
                window.AOS.init({
                    once: true,
                    duration: 600,
                    easing: 'ease-out',
                    offset: 120,
                });
            }
        });

    </script>
