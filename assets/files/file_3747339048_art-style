                    const url = target === 'search'
                        ? buildSearchUrl(input)
                        : navigationTargets[target];

                    if (!url) {
                        throw new Error('Unknown navigation target.');
                    }

                    return navigateWithConsent(url, client);
                },
            },
        ];

