    link.classList.add('disabled');

    $.ajax({
      url: url,
      type: 'GET',
      dataType: 'json',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      success: function(data) {
        const postsHtml = `
          <ul class="fb-posts-list">
            ${data.posts.map((post, index) => generateFbPosts(post, data.url, index)).join('')}
