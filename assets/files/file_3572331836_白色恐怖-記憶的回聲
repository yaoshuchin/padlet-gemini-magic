        const endingText = document.getElementById(&#39;ending-text&#39;);
        const reflectionTextSpan = document.getElementById(&#39;reflection-text&#39;);
        const reflectionTitleSpan = document.getElementById(&#39;reflection-title&#39;);
        const backToStartButton = document.getElementById(&#39;back-to-start&#39;);

        let currentChar = null;
        let currentSceneId = null;

        // Helper to parse nextScene string (e.g., &quot;student:scene2A&quot; or &quot;reporter:endingB&quot;)
        function parseNextScene(nextSceneString) {
            const parts = nextSceneString.split(&#39;:&#39;);
            if (parts.length !== 2) {
                 console.error(&quot;Invalid nextScene string format:&quot;, nextSceneString);
                return null;
            }
            return { char: parts[0], id: parts[1] };
        }


        // 過渡動畫效果 (主畫面切換) - 時間調整為 1秒
        function transitionScreens(hideScreen, showScreen, callback) {
            // Ensure elements are properly positioned for the transition
             [hideScreen, showScreen].forEach(screen =&gt; {
                 screen.style.position = &#39;absolute&#39;;
                 screen.style.top = &#39;50%&#39;;
                 screen.style.left = &#39;50%&#39;;
                 screen.style.transform = &#39;translate(-50%, -50%)&#39;;
             });

             // Set initial state for the showing screen
             showScreen.style.opacity = &#39;0&#39;;
             showScreen.style.transform = &#39;translate(-50%, -48%) scale(0.98)&#39;; // Starts slightly up/smaller

             // Bring the hiding screen to front briefly during transition
             hideScreen.style.zIndex = 2;
             showScreen.style.zIndex = 1;


            // Trigger hide animation
            hideScreen.style.opacity = &#39;0&#39;;
            hideScreen.style.transform = &#39;translate(-50%, -52%) scale(0.98)&#39;; // Slides slightly down/smaller

            const transitionEndPromise = new Promise(resolve =&gt; {
                 const handler = () =&gt; {
                    hideScreen.classList.add(&#39;hidden&#39;); // Hide display after transition
                    hideScreen.style.opacity = &#39;&#39;; // Reset style
                    hideScreen.style.transform = &#39;&#39;; // Reset style
                    hideScreen.style.zIndex = &#39;&#39;; // Reset z-index

                    hideScreen.removeEventListener(&#39;transitionend&#39;, handler); // Clean up
                    resolve();
                 };

                if (hideScreen.classList.contains(&#39;hidden&#39;)) {
                    resolve();
                } else {
                     // Listen for opacity transition end
                     hideScreen.addEventListener(&#39;transitionend&#39;, handler, { once: true });
                     // Add a fallback timeout - slightly longer than the new transition
                     setTimeout(handler, 1100); // 1.1s fallback
                }
            });


             transitionEndPromise.then(() =&gt; {
                // After hiding screen is hidden, show the new screen and trigger its transition
                showScreen.classList.remove(&#39;hidden&#39;); // Make target screen visible
                 showScreen.style.zIndex = &#39;&#39;; // Reset z-index

                 // Force reflow to apply starting styles before animating
                 void showScreen.offsetHeight;

                // Trigger show animation
                showScreen.style.opacity = &#39;1&#39;;
                showScreen.style.transform = &#39;translate(-50%, -50%) scale(1)&#39;; // Animate to final position/scale

                if (callback) callback();
            });
        }


        // 渲染遊戲畫面
        function renderScene(char, sceneId) {
            if (!gameData[char] || !gameData[char][sceneId]) {
                alert(&quot;錯誤：找不到劇情！(&quot; + char + &quot;:&quot; + sceneId + &quot;) 請重新開始。&quot;);
                showStartScreen();
                return;
            }

            const scene = gameData[char][sceneId];
            currentChar = char; // Update current state
            currentSceneId = sceneId; // Update current state

            // Set content
            characterTitle.textContent = `${getCharacterName(char)} 的回憶`;
            storyText.textContent = scene.text;
            historicalFactSpan.textContent = scene.historicalFact;
            // historicalFactTitleSpan is static in HTML

            // Clear previous options
            optionsContainer.innerHTML = &#39;&#39;;

            // Create buttons for options
            scene.options.forEach(option =&gt; {
                const button = document.createElement(&#39;button&#39;);
                button.textContent = option.text;
                button.dataset.nextScene = option.nextScene;
                button.addEventListener(&#39;click&#39;, handleOptionClick);
                optionsContainer.appendChild(button);
            });

             // renderScene doesn&#39;t handle visibility, transitionScreens or handleOptionClick&#39;s timeout does.
        }

        // 渲染結局畫面
        function renderEnding(char, endingId) {
             if (!endings[char] || !endings[char][endingId]) {
                alert(&quot;錯誤：找不到結局！(&quot; + char + &quot;:&quot; + endingId + &quot;) 請重新開始。&quot;);
                showStartScreen();
                return;
            }

            const ending = endings[char][endingId];

            // Set content
            endingTitle.textContent = ending.title;
            endingText.textContent = ending.text;
            reflectionTextSpan.textContent = ending.reflection;
             // reflectionTitleSpan is static in HTML

            // renderEnding doesn&#39;t handle visibility, transitionScreens does.
        }

        // 處理選項點擊
        function handleOptionClick(event) {
            const nextSceneData = parseNextScene(event.target.dataset.nextScene);

             if (!nextSceneData) {
                 alert(&quot;錯誤：無效的下一個劇情或結局連結。請重新開始。&quot;);
                 showStartScreen();
                 return;
             }

            const { char: nextChar, id: nextId } = nextSceneData;
            const isEnding = nextId.startsWith(&#39;ending&#39;);

             if (isEnding) {
                 transitionScreens(gameScreen, endingScreen, () =&gt; {
                     renderEnding(currentChar, nextId); // Use currentChar for ending data lookup
                 });
             } else {
                 // Transition *within* the game screen to a new scene for the same character
                 const gameContentElements = gameScreen.querySelectorAll(&#39;#story-text, .historical-fact, #options-container&#39;);

                 // Step 1: Start fade out and slide up animation for current content
                 gameContentElements.forEach(el =&gt; {
                      el.style.opacity = &#39;0&#39;;
                      el.style.transform = &#39;translateY(-20px)&#39;; /* Adjusted slide up */
                 });

                 // Step 2: Wait for fade out duration (0.8s), then update content and trigger fade in
                 setTimeout(() =&gt; {
                     // Update content for the next scene
                     renderScene(currentChar, nextId);

                     // Force reflow AFTER content update but BEFORE triggering the next animation
                     void gameScreen.offsetHeight;

                     // Step 3: Start fade in and slide down animation for the NEW content
                     const newGameContentElements = gameScreen.querySelectorAll(&#39;#story-text, .historical-fact, #options-container&#39;);

                     newGameContentElements.forEach(el =&gt; {
                         // Set initial state for fade-in animation
                         el.style.opacity = &#39;0&#39;;
                         el.style.transform = &#39;translateY(20px)&#39;; /* Adjusted slide down */
                     });

                     // Force reflow *again* to apply the initial state for fade-in before animating
                     void gameScreen.offsetHeight;

                     // Trigger fade-in and slide up animation
                     newGameContentElements.forEach(el =&gt; {
                         el.style.opacity = &#39;1&#39;;
                         el.style.transform = &#39;translateY(0)&#39;; // Animate to final position
                     });

                 }, 900); // Wait time (slightly longer than 0.8s transition)
             }
        }

        // 顯示開始畫面並隱藏其他畫面
        function showStartScreen() {
            currentChar = null;
            currentSceneId = null;
            transitionScreens(gameScreen.classList.contains(&#39;hidden&#39;) ? endingScreen : gameScreen, startScreen);
        }

        // 處理角色選擇
        function handleCharacterSelect(event) {
            const selectedChar = event.target.dataset.character;
            currentChar = selectedChar;

            transitionScreens(startScreen, gameScreen, () =&gt; {
                // After gameScreen is shown, render the first scene
                renderScene(currentChar, &#39;scene1&#39;);

                 // Trigger the initial fade-in for game screen content after rendering
                 const gameContentElements = gameScreen.querySelectorAll(&#39;#story-text, .historical-fact, #options-container&#39;);
                 gameContentElements.forEach(el =&gt; {
                      el.style.opacity = &#39;0&#39;; // Set initial state before reflow
                      el.style.transform = &#39;translateY(20px)&#39;; /* Adjusted slide down */
                 });
                 void gameScreen.offsetHeight; // Reflow

                  gameContentElements.forEach(el =&gt; {
                      el.style.opacity = &#39;1&#39;; // Trigger animation
                      el.style.transform = &#39;translateY(0)&#39;;
                 });
            });
        }

        // 獲取角色中文名稱
        function getCharacterName(charKey) {
            switch(charKey) {
                case &#39;student&#39;: return &#39;大學生&#39;;
                case &#39;reporter&#39;: return &#39;記者&#39;;
                case &#39;teacher&#39;: return &#39;老師&#39;;
                default: return &#39;&#39;;
            }
        }

        // 初始化：綁定事件監聽器並顯示開始畫面
        function initializeGame() {
            // Bind character selection buttons
            document.querySelectorAll(&#39;#start-screen button&#39;).forEach(button =&gt; {
                button.addEventListener(&#39;click&#39;, handleCharacterSelect);
            });

            // Bind back to start button
            backToStartButton.addEventListener(&#39;click&#39;, showStartScreen);

            // Initially hide game and ending screens
            gameScreen.classList.add(&#39;hidden&#39;);
            endingScreen.classList.add(&#39;hidden&#39;);
            startScreen.classList.remove(&#39;hidden&#39;); // Ensure start screen is visible initially

            // Apply transition property after initial display state is set
            // This prevents transitions on page load
             setTimeout(() =&gt; {
                // Apply transitions for main screen switching
                document.querySelectorAll(&#39;.screen&#39;).forEach(screen =&gt; {
                     screen.style.transition = &#39;opacity 1s ease-in-out, transform 1s ease-in-out&#39;; /* Faster */
                });

                // Apply transitions for content elements *within* the game screen (for internal scene changes)
                const gameContentElements = gameScreen.querySelectorAll(&#39;#story-text, .historical-fact, #options-container&#39;);
                gameContentElements.forEach(el =&gt; {
                     el.style.transition = &#39;opacity 0.8s ease-in-out, transform 0.8s ease-in-out&#39;; /* Faster */
                });

                 // Apply transition for button hover/active states
                 document.querySelectorAll(&#39;button&#39;).forEach(button =&gt; {
                     button.style.transition = &#39;background-color 0.2s ease, transform 0.1s ease&#39;; /* Faster hover */
                 });


             }, 50); // Small delay
        }

        // 頁面加載完成後執行初始化
        window.addEventListener(&#39;load&#39;, initializeGame);

    &lt;/script&gt;

